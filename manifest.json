{
    "manifest_version": 3,
    "name": "Gmail Travel → Google Calendar",
    "version": "1.0.0",
    "description": "Adds a one-click button to Gmail travel cards to create Google Calendar events.",
    "permissions": [],
    "host_permissions": [
      "https://mail.google.com/*",
      "https://calendar.google.com/*"
    ],
    "content_scripts": [
      {
        "matches": ["https://mail.google.com/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }